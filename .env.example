# Copy this file to .env and fill in values for your environment.
# .env is gitignored — never commit it. The same file name is used on all machines.

# ── nginx reverse proxy (injected at container start via envsubst) ────────────

# DNS resolver nginx uses to resolve the backend hostname at request time.
#   Local Podman:  10.89.0.1
#   Prod Linode:   8.8.8.8
NGINX_DNS_RESOLVER=10.89.0.1

# Full URL of the backend as seen from inside the nginx container.
#   Local:  http://reporting-server:8000
#   Prod:   https://api.report.subodhsingh.in
NGINX_BACKEND_URL=http://reporting-server:8000

# Hostname sent in the Host header and used to rewrite Set-Cookie domain.
#   Local:  reporting-server
#   Prod:   api.report.subodhsingh.in
NGINX_BACKEND_HOST=reporting-server

# ── Docker Compose ────────────────────────────────────────────────────────────

# Host port binding.
#   Local:  3000                 (all interfaces)
#   Prod:   127.0.0.1:3000       (localhost only — host nginx handles SSL)
HOST_PORT=3000

# Name of the external Docker/Podman network to attach to.
#   Local:  reporting-server_default   (created by the backend compose stack)
#   Prod:   reporting-ui-net           (create once: podman network create reporting-ui-net)
BACKEND_NETWORK_NAME=reporting-server_default

# ── Vite — baked into the JS bundle at build time ────────────────────────────
# Leave empty — nginx proxies /api/* so no cross-origin URL is needed.
VITE_API_BASE_URL=
